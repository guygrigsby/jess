# Compiled binaries
/bin/
*.test
*.out
/quickstart
# Anything in examples/*/ that's a bare-named build artifact. Each
# example main package compiles to a binary named after its dir.
/examples/*/quickstart
/examples/*/main

# Editor / OS scratch
.DS_Store
.idea/
.vscode/
*.swp

# Go build cache + module cache shouldn't be checked in
/vendor/

# Coverage
coverage.out
coverage.html
